{
  "name": "@react-component-selector-mcp/react",
  "version": "2.0.0",
  "description": "React component selector with browser selection UI",
  "license": "MIT",
  "author": "zakstam",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakstam/react-component-selector-mcp.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/zakstam/react-component-selector-mcp",
  "bugs": "https://github.com/zakstam/react-component-selector-mcp/issues",
  "keywords": [
    "react",
    "component",
    "selector",
    "mcp",
    "claude",
    "model-context-protocol"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');const f='dist/index.js';fs.writeFileSync(f,'\\\"use client\\\";\\n'+fs.readFileSync(f))\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@react-component-selector-mcp/shared": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
