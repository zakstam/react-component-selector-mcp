{
  "name": "react-component-selector-mcp-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build && node scripts/copy-readme.mjs",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:check": "pnpm typecheck && pnpm build",
    "release:prepare": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "release:publish-oidc": "bash scripts/publish-oidc.sh",
    "release:status": "changeset status",
    "release:full": "pnpm release:check && pnpm release:version && pnpm release:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "enquirer@2.4.1": "patches/enquirer@2.4.1.patch"
    },
    "patchedDependenciesComments": {
      "enquirer@2.4.1": "Fixes regex crash on Windows paths (backslash chars). See: https://github.com/enquirer/enquirer/issues/285"
    }
  }
}
